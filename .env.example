# Environment Configuration for PolicyGuard AI

# Model / LLM Configuration
# Supports: 'gemini' (Google Gemini Flash), 'mock' (ultra-fast offline testing), 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant)
# If QDRANT_LOCATION is ':memory:' or a local path like './qdrant_storage', runs locally without Docker
QDRANT_LOCATION=./qdrant_storage
QDRANT_COLLECTION=enterprise_policies
QDRANT_URL=
QDRANT_API_KEY=

# SQL Policy Database
SQLITE_DB_PATH=data/policy_database.sqlite

# System & Performance Tuning
MAX_RETRIEVAL_CHUNKS=7
HYBRID_RRF_K=60
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
LATENCY_BUDGET_MS=800
GUARDRAIL_SELF_CORRECT=true
LOG_LEVEL=INFO
